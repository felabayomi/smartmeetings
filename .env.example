# Required application services
DATABASE_URL=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Required web-push credentials. Generate a fresh pair for each environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Required when scan-image storage and extraction are enabled
BLOB_READ_WRITE_TOKEN=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional comma-separated origins accepted by Clerk authentication
AUTHORIZED_PARTIES=https://meetminder.app,https://www.meetminder.app,https://meetmind.us,https://www.meetmind.us

# Legacy Express package only; leave unset when that package is unused.
MEETMIND_API_KEY=
MEETMIND_ADMIN_CALENDAR_TOKEN=
REMINDER_EMAIL_TO=
